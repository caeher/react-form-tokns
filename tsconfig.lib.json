{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "src",
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/lib/**/*",
    "src/components/**/*"
  ],
  "exclude": [
    "src/App.tsx",
    "src/main.tsx",
    "src/App.css",
    "src/vite-env.d.ts"
  ]
}
